# ---------------------------------------------------------------------------
# App
# ---------------------------------------------------------------------------
NODE_ENV=production
NEXT_TELEMETRY_DISABLED=1
PORT=3000
HOSTNAME=0.0.0.0

# Origen público del sitio. Necesario para que canonical/hreflang de /[lang]
# se emitan como URLs absolutas (Google descarta los hreflang relativos).
NEXT_PUBLIC_SITE_URL=https://tu-dominio.com

# ---------------------------------------------------------------------------
# Supabase
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_WEBHOOK_SECRET=

# ---------------------------------------------------------------------------
# Sanity
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SANITY_PROJECT_ID=
# Nombre EXACTO del dataset (ojo: no siempre es "production"; compruébalo con
# `curl -H "Authorization: Bearer $SANITY_API_TOKEN" \
#   https://api.sanity.io/v2025-01-01/projects/<projectId>/datasets`).
# Si no coincide, todas las consultas GROQ dan 404 y el i18n cae en silencio al
# idioma por defecto con cero cadenas.
NEXT_PUBLIC_SANITY_DATASET=production
SANITY_API_VERSION=2025-01-01
SANITY_API_TOKEN=
SANITY_WEBHOOK_SECRET=

# ---------------------------------------------------------------------------
# Cloudinary
# ---------------------------------------------------------------------------
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Identificadores reales de marca (public_id en Cloudinary). Opcionales:
# si se omiten, el código usa los IDs verificados de la cuenta de producción.
# NEXT_PUBLIC_CLOUDINARY_LOGO_ID=logo_ztmh8j
# NEXT_PUBLIC_CLOUDINARY_GLOBE_ID=Rotating_earth__large_vwcedm
# NEXT_PUBLIC_CLOUDINARY_FAVICON_ID=favicon-32x32_fbfnr6
# NEXT_PUBLIC_CLOUDINARY_APPLE_ICON_ID=apple-touch-icon_bwwwdv
# NEXT_PUBLIC_CLOUDINARY_PERMIT_CITES=Code_CITES_ht5gyv
# NEXT_PUBLIC_CLOUDINARY_PERMIT_SERFOR=COode_SERFOR_yqgswm
# NEXT_PUBLIC_CLOUDINARY_PERMIT_VUCE=Code_VUCE_vzlhha
# NEXT_PUBLIC_CLOUDINARY_PERMIT_SENASA=Code_SENASA_gi5qfd

# ---------------------------------------------------------------------------
# n8n (DigitalOcean) — sincronización continua
# ---------------------------------------------------------------------------
N8N_WEBHOOK_URL=https://n8n.tu-dominio.com/webhook
N8N_WEBHOOK_TOKEN=

# Secreto que n8n envía como `x-sync-secret` al llamar de vuelta a
# /api/sync/specimens (el endpoint que hace el upsert real Sanity → Supabase,
# distinto del webhook de solo-relay en /api/webhooks/sanity).
SYNC_WEBHOOK_SECRET=

# ---------------------------------------------------------------------------
# i18n global (rutas /[lang]/…)
# ---------------------------------------------------------------------------
# Idioma por defecto usado por el middleware y como fallback cuando Sanity no
# está disponible. El conjunto real de idiomas habilitados vive en Sanity
# (documento siteSettings).
NEXT_PUBLIC_DEFAULT_LOCALE=en

# Set mínimo de idiomas cuando Sanity no responde o aún no tiene siteSettings.
# Sirve para dev/CI y para validar el enrutado por variante antes de redactar el
# contenido. Cuando el CMS responde, su lista SIEMPRE manda sobre esta.
# Variantes asiáticas independientes (no son alias entre sí):
#   zh-CN China Continental · zh-HK Hong Kong · zh-MO Macao · zh-TW Taiwán
#   ko Corea del Sur · ja Japón
NEXT_PUBLIC_FALLBACK_LOCALES=es,en,pt,zh-CN,zh-HK,zh-MO,zh-TW,ko,ja

# --- Geolocalización por IP -------------------------------------------------
# El país se toma primero de la cabecera del borde (cf-ipcountry,
# x-vercel-ip-country, x-geo-country de nginx GeoIP): es gratis e instantáneo.
# En despliegues sin esas cabeceras (standalone/DigitalOcean) se resuelve desde
# la IP con este proveedor. Vacío/none = desactivado (cae a Accept-Language).
#   ipapi  → ip-api.com (sin clave, http en el plan gratuito)
#   ipinfo → ipinfo.io (usa GEOIP_API_KEY)
#   custom → GEOIP_API_URL con el marcador {ip}, respuesta JSON
GEOIP_PROVIDER=
GEOIP_API_KEY=
GEOIP_API_URL=
# Presupuesto de latencia de la consulta geo; al agotarse se sigue sin país.
GEOIP_TIMEOUT_MS=400

# Traducción automática (fallback para locales sin cadenas autorizadas).
# TRANSLATION_PROVIDER: deepl | google | libre | none (vacío = passthrough)
TRANSLATION_PROVIDER=
TRANSLATION_API_KEY=
# Opcional: endpoint propio (LibreTranslate self-host, proxy DeepL, etc.)
TRANSLATION_API_URL=
