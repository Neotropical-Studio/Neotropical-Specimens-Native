# ---------------------------------------------------------------------------
# App
# ---------------------------------------------------------------------------
NODE_ENV=production
NEXT_TELEMETRY_DISABLED=1
PORT=3000
HOSTNAME=0.0.0.0

# Origen público del sitio. Necesario para que canonical/hreflang de /[lang]
# se emitan como URLs absolutas (Google descarta los hreflang relativos).
NEXT_PUBLIC_SITE_URL=https://tu-dominio.com

# ---------------------------------------------------------------------------
# Neon PostgreSQL
# ---------------------------------------------------------------------------
DATABASE_URL=postgresql://user:password@host/neondb?sslmode=require

# ---------------------------------------------------------------------------
# Cloudinary
# ---------------------------------------------------------------------------
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Identificadores reales de marca (public_id en Cloudinary). Opcionales:
# si se omiten, el código usa los IDs verificados de la cuenta de producción.
# NO uses los alias antiguos `neotropical-logo` / `neotropical-globe` (404).
# NEXT_PUBLIC_CLOUDINARY_LOGO_ID=logo_ztmh8j
# NEXT_PUBLIC_CLOUDINARY_GLOBE_ID=Rotating_earth__large_vwcedm
# NEXT_PUBLIC_CLOUDINARY_FAVICON_ID=favicon-32x32_fbfnr6
# NEXT_PUBLIC_CLOUDINARY_APPLE_ICON_ID=apple-touch-icon_bwwwdv
# NEXT_PUBLIC_CLOUDINARY_PERMIT_CITES=Code_CITES_ht5gyv
# NEXT_PUBLIC_CLOUDINARY_PERMIT_SERFOR=COode_SERFOR_yqgswm
# NEXT_PUBLIC_CLOUDINARY_PERMIT_VUCE=Code_VUCE_vzlhha
# NEXT_PUBLIC_CLOUDINARY_PERMIT_SENASA=Code_SENASA_gi5qfd

# ---------------------------------------------------------------------------
# n8n (DigitalOcean) — sincronización continua
# ---------------------------------------------------------------------------
N8N_WEBHOOK_URL=https://n8n.tu-dominio.com/webhook
N8N_WEBHOOK_TOKEN=

# Secreto que n8n envía como `x-sync-secret` al llamar de vuelta a los endpoints
# de sincronización, si se habilita esa automatización.
SYNC_WEBHOOK_SECRET=

# ---------------------------------------------------------------------------
# Pasarelas nativas (NUNCA Stripe / PayPal / similares)
# Completar en sandbox antes de producción. Vacío = solo cotización local.
# ---------------------------------------------------------------------------
# WorldFirst Checkout retail ($100–$5,000 USD)
# Emite el QR; el cliente paga con Alipay o WeChat Pay.
WORLDFIRST_CLIENT_ID=
WORLDFIRST_CLIENT_SECRET=
WORLDFIRST_MERCHANT_ID=
WORLDFIRST_WEBHOOK_SECRET=
WORLDFIRST_ENV=sandbox

# Alipay / WeChat Pay — métodos QR bajo WorldFirst (no pasarelas sueltas)
ALIPAY_APP_ID=
ALIPAY_PRIVATE_KEY=
ALIPAY_NOTIFY_URL=
WECHAT_PAY_MCH_ID=
WECHAT_PAY_APP_ID=
WECHAT_PAY_API_KEY=
WECHAT_PAY_NOTIFY_URL=

# XTransfer — B2B / lotes $5,000–$2,000,000 USD (liquidación 3–4 días hábiles)
XTRANSFER_CLIENT_ID=
XTRANSFER_CLIENT_SECRET=
XTRANSFER_ACCOUNT_ID=
XTRANSFER_WEBHOOK_SECRET=
XTRANSFER_ENV=sandbox

# Docs post-checkout: Factura + Packing List + Contrato → correo automático
# Sin RESEND_API_KEY = dry-run (genera HTML dinámico, no envía).
EXPORT_DOCS_FROM_EMAIL=
RESEND_FROM_EMAIL=
RESEND_API_KEY=
EXPORT_DOCS_SMTP_URL=

# Webhooks (URL pública → /api/webhooks/worldfirst | /api/webhooks/xtransfer)
# WORLDFIRST_WEBHOOK_SECRET=  (ya arriba)
# XTRANSFER_WEBHOOK_SECRET=   (ya arriba)

# ---------------------------------------------------------------------------
# Couriers (origen Perú)
# Estándar: Serpost SA · Exportafacil · EMS Internacional
# Especiales (opción del cliente): FedEx · DHL
# EasyPost = bridge opcional para tarifas live FedEx/DHL
# ---------------------------------------------------------------------------
EASYPOST_API_KEY=
SHIP_FROM_NAME=Neotropical Specimens
SHIP_FROM_COMPANY=House Insects of Peru E.I.R.L.
SHIP_FROM_STREET1=Tingo Maria
SHIP_FROM_CITY=Tingo Maria
SHIP_FROM_STATE=Huanuco
SHIP_FROM_ZIP=10101
SHIP_FROM_COUNTRY=PE
SHIP_FROM_PHONE=
SHIP_FROM_EMAIL=

# ---------------------------------------------------------------------------
# i18n global (rutas /[lang]/…)
# ---------------------------------------------------------------------------
# Idioma por defecto usado por el middleware y como fallback.
NEXT_PUBLIC_DEFAULT_LOCALE=en

# Set mínimo de idiomas para dev/CI y para validar el enrutado por variante.
# Variantes asiáticas independientes (no son alias entre sí):
#   zh-CN China Continental · zh-HK Hong Kong · zh-MO Macao · zh-TW Taiwán
#   ko Corea del Sur · ja Japón
NEXT_PUBLIC_FALLBACK_LOCALES=es,en,pt,zh-CN,zh-HK,zh-MO,zh-TW,ko,ja

# --- Geolocalización por IP -------------------------------------------------
# El país se toma primero de la cabecera del borde (cf-ipcountry,
# x-geo-country de nginx GeoIP): es gratis e instantáneo.
# En despliegues sin esas cabeceras (standalone/DigitalOcean) se resuelve desde
# la IP con este proveedor. Vacío/none = desactivado (cae a Accept-Language).
#   ipapi  → ip-api.com (sin clave, http en el plan gratuito)
#   ipinfo → ipinfo.io (usa GEOIP_API_KEY)
#   custom → GEOIP_API_URL con el marcador {ip}, respuesta JSON
GEOIP_PROVIDER=
GEOIP_API_KEY=
GEOIP_API_URL=
# Presupuesto de latencia de la consulta geo; al agotarse se sigue sin país.
GEOIP_TIMEOUT_MS=400

# Traducción automática (fallback para locales sin cadenas autorizadas).
# TRANSLATION_PROVIDER: deepl | google | libre | none (vacío = passthrough)
TRANSLATION_PROVIDER=
TRANSLATION_API_KEY=
# Opcional: endpoint propio (LibreTranslate self-host, proxy DeepL, etc.)
TRANSLATION_API_URL=
